  <diagram id="LEITURA" name="LEITURA Como ler e justificar os modelos">
    <mxGraphModel page="1" pageWidth="1600" pageHeight="1000" background="#10171d">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Como ler e justificar os modelos" style="text;html=0;fontSize=34;fontStyle=1;align=left;fontColor=#f3f5f5;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="1480" height="55" as="geometry" />
        </mxCell>
        <mxCell id="note" value="As vistas formam dois modelos. Uma classe repetida representa o mesmo conceito. A memória de modelagem mantém os atributos completos, as regras e o vínculo com os 45 RF." style="text;whiteSpace=wrap;html=0;fontSize=19;align=left;fontColor=#b7c6ce;" vertex="1" parent="1">
          <mxGeometry x="60" y="887" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="guide_title_195" value="Fronteira e atores" style="text;html=0;align=left;fontSize=24;fontStyle=1;fontColor=#99c8b4;" vertex="1" parent="1">
          <mxGeometry x="65" y="195" width="1470" height="35" as="geometry" />
        </mxCell>
        <mxCell id="guide_body_195" value="O retângulo delimita o Víamos. Cliente, Intérprete, Backoffice, Suporte e serviços externos ficam fora. Participante reúne Cliente e Intérprete; Usuário reúne os perfis humanos no acesso." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=21;fontColor=#b7c6ce;" vertex="1" parent="1">
          <mxGeometry x="65" y="234" width="1470" height="85" as="geometry" />
        </mxCell>
        <mxCell id="guide_title_325" value="Relações entre casos de uso" style="text;html=0;align=left;fontSize=24;fontStyle=1;fontColor=#99c8b4;" vertex="1" parent="1">
          <mxGeometry x="65" y="325" width="1470" height="35" as="geometry" />
        </mxCell>
        <mxCell id="guide_body_325" value="«include»: comportamento obrigatório incluído no caso base. «extend»: comportamento opcional, com seta para o caso base. Linhas contínuas ligam atores às funcionalidades; não indicam sequência." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=21;fontColor=#b7c6ce;" vertex="1" parent="1">
          <mxGeometry x="65" y="364" width="1470" height="85" as="geometry" />
        </mxCell>
        <mxCell id="guide_title_455" value="Classes e multiplicidades" style="text;html=0;align=left;fontSize=24;fontStyle=1;fontColor=#99c8b4;" vertex="1" parent="1">
          <mxGeometry x="65" y="455" width="1470" height="35" as="geometry" />
        </mxCell>
        <mxCell id="guide_body_455" value="Compartimentos: nome, atributos (-) e métodos (+). Triângulo vazio aponta à superclasse. Losango cheio marca composição. 1 = exatamente um; 0..1 = opcional; 0..* = zero ou muitos." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=21;fontColor=#b7c6ce;" vertex="1" parent="1">
          <mxGeometry x="65" y="494" width="1470" height="85" as="geometry" />
        </mxCell>
        <mxCell id="guide_title_585" value="Detalhamento sem sobrecarregar as figuras" style="text;html=0;align=left;fontSize=24;fontStyle=1;fontColor=#99c8b4;" vertex="1" parent="1">
          <mxGeometry x="65" y="585" width="1470" height="35" as="geometry" />
        </mxCell>
        <mxCell id="guide_body_585" value="Os desenhos mostram atributos e operações principais. O catálogo de apoio preserva todos os 34 casos de uso, 31 classes, atributos, assinaturas, regras, RF/RNF e o inventário das 32 fontes do Drive." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=21;fontColor=#b7c6ce;" vertex="1" parent="1">
          <mxGeometry x="65" y="624" width="1470" height="85" as="geometry" />
        </mxCell>
        <mxCell id="guide_title_715" value="Referências" style="text;html=0;align=left;fontSize=24;fontStyle=1;fontColor=#99c8b4;" vertex="1" parent="1">
          <mxGeometry x="65" y="715" width="1470" height="35" as="geometry" />
        </mxCell>
        <mxCell id="guide_body_715" value="PIRES, Luis Fernando dos Santos. Blueprinting Software with UML: p. 4, 8, 10 e 12. GUEDES, Gilleanes T. A. UML 2: uma abordagem prática. 3. ed., Novatec, 2018, capítulos 3 e 4. Projeto Víamos: entregas de Engenharia de Requisitos, PRD, contexto e protótipos." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=21;fontColor=#b7c6ce;" vertex="1" parent="1">
          <mxGeometry x="65" y="754" width="1470" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>