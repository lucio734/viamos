        </mxCell>
        <mxCell id="note" value="UC14-UC17. Consultar, aceitar e recusar são objetivos distintos. O aceite é exclusivo: a mesma solicitação não pode gerar dois atendimentos." style="text;whiteSpace=wrap;html=0;fontSize=19;align=left;fontColor=#b7c6ce;" vertex="1" parent="1">
