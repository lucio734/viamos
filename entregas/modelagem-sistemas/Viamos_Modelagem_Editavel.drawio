        <mxCell id="banner" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1a2e44;strokeColor=#1a2e44;strokeWidth=1.8;fontColor=#213547;fontSize=17;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1440" height="12" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="VÍAMOS  /  MODELAGEM DE SISTEMAS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="32" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Escopo, fontes e critérios de leitura" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=30;fontColor=#1a2e44;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="62" width="1330" height="39.0" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Uma base de requisitos; quatro perspectivas complementares." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="109" width="1320" height="20.8" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#cbd5df;strokeWidth=1;endArrow=none;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="48" y="145" as="sourcePoint" />
            <mxPoint x="1392" y="145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t5" value="DOMÍNIO" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="185" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="O Víamos conecta cliente surdo e intérprete habilitado para atendimento presencial. Backoffice analisa certificações; Suporte atende chamados. Mapas, gateway financeiro, push, e-mail e localização do dispositivo ficam fora da fronteira do software." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="215" width="1320" height="46.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="BASE CONSULTADA" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="330" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="34 arquivos importados: 5 Markdown, 12 HTML, 12 PNG, 2 XLSX, 1 DOCX, 1 PDF e 1 Draw.io. A planilha consolidada contém 45 RF, 45 RNF e 24 histórias (113 pontos). A entrega UML anterior contém 23 vistas. Os dois PDFs da disciplina completam as referências." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="360" width="1320" height="46.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="LEITURA DOS MODELOS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="475" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="C1–C2 são vistas do mesmo contexto. B1–B6 detalham processos BPMN em raias. D1–D6 são vistas do mesmo DFD lógico de nível 1: P1–P6 e depósitos D1–D6 se repetem sem duplicação. E1 representa o ciclo da solicitação e de seu atendimento associado." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="505" width="1320" height="46.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="NOTAÇÃO" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="620" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="Contexto/DFD: retângulos = entidades externas; caixas arredondadas numeradas = processos; duas linhas paralelas = depósitos; setas = dados. BPMN: círculo fino = início; grosso = fim; tarefa arredondada; losango com X = decisão exclusiva; círculo duplo = espera. UML: estado arredondado; transição = evento [guarda] / ação." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="650" width="1320" height="70.2" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="DECISÕES DE CONSISTÊNCIA" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="765" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t14" value="Requisitos e contexto prevalecem sobre resíduos dos protótipos: sem videochamada; mínimo contratado de 60 min; raio de distribuição de até 15 km; check-in até 200 m e erro de posição até 50 m. Conclusão do atendimento não depende de aprovação do pagamento." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="795" width="1320" height="46.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#cbd5df;strokeWidth=1;endArrow=none;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="48" y="970" as="sourcePoint" />
            <mxPoint x="1392" y="970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t16" value="FECAP • Ciência da Computação • 4º semestre | 01-leitura" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=11;fontColor=#526578;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
