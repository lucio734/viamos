  <diagram id="B5-pagamento" name="B5-pagamento | BPMN | cobrança e tratamento de falha">
    <mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1a2e44;strokeColor=#1a2e44;strokeWidth=1.8;fontColor=#213547;fontSize=17;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1440" height="12" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="VÍAMOS  /  MODELAGEM DE SISTEMAS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="32" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="BPMN | cobrança e tratamento de falha" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=30;fontColor=#1a2e44;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="62" width="1330" height="39.0" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Pré-condição: atendimento concluído. O gateway é um participante externo, em pool separado." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="109" width="1320" height="20.8" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#cbd5df;strokeWidth=1;endArrow=none;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="48" y="145" as="sourcePoint" />
            <mxPoint x="1392" y="145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t5" value="JUSTIFICATIVA E REGRAS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=13;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="834" width="1300" height="16.900000000000002" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="A requisição e o retorno do gateway são fluxos de mensagem (tracejados), nunca sequência entre pools. Pagamento aprovado gera crédito uma única vez; falha permite nova tentativa. A conclusão do atendimento e a emissão do comprovante não são desfeitas por falha financeira. Repasses e saldo são detalhados em P4." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
