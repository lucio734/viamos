  <diagram id="E1-estados" name="E1-estados | Máquina de estados | solicitação e atendimento associado">
    <mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
