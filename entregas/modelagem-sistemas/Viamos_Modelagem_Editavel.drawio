        <mxCell id="t3" value="Vista 1/2 do processo 0. Os serviços externos da vista C2 integram a mesma fronteira." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
