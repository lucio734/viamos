        <mxCell id="t2" value="Máquina de estados | solicitação e atendimento associado" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=30;fontColor=#1a2e44;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
