        <mxCell id="t5" value="JUSTIFICATIVA E REGRAS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=13;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
