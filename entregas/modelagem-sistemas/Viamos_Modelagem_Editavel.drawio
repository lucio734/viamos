        </mxCell>
        <mxCell id="t3" value="UML • evento [guarda] / ação • estados de RF18; pagamento possui ciclo próprio." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="109" width="1320" height="20.8" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#cbd5df;strokeWidth=1;endArrow=none;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="48" y="145" as="sourcePoint" />
            <mxPoint x="1392" y="145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t5" value="JUSTIFICATIVA E REGRAS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=13;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="834" width="1300" height="16.900000000000002" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="A criação acontece somente após confirmar o resumo. Recusa e ausência de elegíveis mantêm a busca. O aceite exclusivo cria o vínculo; só check-in válido inicia. O encerramento conclui o serviço mesmo se a cobrança falhar. Cancelamento antes do início é sujeito à política; nenhum prazo de expiração ou estado de falta foi inventado." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="859" width="1330" height="39.0" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="RF16–RF19, RF22–RF23, RF31–RF33; RNF26, RNF27, RNF36; US09. Setas rotuladas são transições; pontos pretos = início/fim." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526578;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="938" width="1330" height="15.600000000000001" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="Eventos descritos dentro do estado são internos: não saem do estado nem repetem ações entry. Assim, suporte não reinicia o relógio e QR inválido não refaz o aceite." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="560" y="185" width="790" height="41.6" as="geometry" />
        </mxCell>
