        <mxCell id="t3" value="Processo acionado em “Buscando intérprete” ou “Aceita”; em andamento, o fluxo documentado é encerramento." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
