        <mxCell id="e4" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#cbd5df;strokeWidth=1;endArrow=none;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="48" y="145" as="sourcePoint" />
            <mxPoint x="1392" y="145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t5" value="Presencial e duração" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="180" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="RNF28 e RF13 prevalecem sobre os resíduos “Online”, link de reunião e 30 min dos protótipos. Duração real pode diferir da contratada." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="211" width="1320" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="Aceite, recusa e ausência" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="299" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="RF22 exige exclusividade; RF23 torna o motivo de recusa opcional. Sem profissional, mantém-se a busca; não foi criado tempo de expiração. Não há alocação em dupla no modelo principal." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="330" width="1320" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="Cancelamento e preço" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="418" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="US09 limita cancelamento ao serviço não iniciado. Prazo, taxa, fórmula da estimativa, excedentes e arredondamento devem ser definidos pelo grupo; os modelos usam política configurada sem atribuir valores." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="449" width="1320" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="Pagamento e comprovante" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="537" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="RF33, RF37 e US12 liberam o pós-atendimento por conclusão. Pagamento tem tentativas e resultado próprios. A proposta de repasse pelo gateway acompanha a entrega UML, sem escolher fornecedor." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="568" width="1320" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="Dados, suporte e consentimento" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="656" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t14" value="Chamado não cancela nem encerra automaticamente o serviço. Localização exige consentimento e cessa ao terminar. P6 coordena exportação/exclusão preservando a política de retenção; tratamento detalhado ainda precisa ser definido." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="687" width="1320" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="t15" value="Validade da entrega" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="775" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t16" value="A capa usa a equipe e a instituição confirmadas pelo usuário. Matrículas não foram fornecidas; conferir cabeçalho oficial antes do AVA. Não há envio ao AVA, implementação do aplicativo ou validação jurídica nesta entrega." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="806" width="1320" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#cbd5df;strokeWidth=1;endArrow=none;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="48" y="970" as="sourcePoint" />
            <mxPoint x="1392" y="970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t18" value="FECAP • Ciência da Computação • 4º semestre | M2-decisoes" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=11;fontColor=#526578;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="978" width="1100" height="14.3" as="geometry" />
        </mxCell>
        <mxCell id="t19" value="19 / 20" style="text;html=0;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=11;fontColor=#526578;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="978" width="110" height="14.3" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="M3-referencias" name="M3-referencias | Referências e arquivos de origem">
    <mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1a2e44;strokeColor=#1a2e44;strokeWidth=1.8;fontColor=#213547;fontSize=17;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1440" height="12" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="VÍAMOS  /  MODELAGEM DE SISTEMAS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="32" width="1300" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Referências e arquivos de origem" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=30;fontColor=#1a2e44;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="62" width="1330" height="39.0" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Originais preservados; inventário com caminhos e SHA-256 em projeto/inventario-importacao.json." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="109" width="1320" height="20.8" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#cbd5df;strokeWidth=1;endArrow=none;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="48" y="145" as="sourcePoint" />
            <mxPoint x="1392" y="145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t5" value="1. Guia da atividade" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="180" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="PIRES, Luis Fernando dos Santos. Especificação e Modelagem Integral de Sistemas. Engenharia de Software, atividade curricular prática, 2 páginas. Entregáveis e critérios: pp. 1–2. Arquivo: referencias/modelagem-sistemas/guia-atividade-pratica.pdf." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="211" width="1320" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="2. Material da disciplina" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="300" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="PIRES, Luis Fernando dos Santos. Introdução à Modelagem de Sistemas. 22 slides. Contexto: slides 4–6; processos/BPMN: 7–10; DFD: 11–14; estados: 15–19; ferramentas CASE: 20–21." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="331" width="1320" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="3. Requisitos do Víamos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="420" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="ENTREGA VIAMOS COMPLETA.xlsx: seis abas; RF01–RF45, RNF01–RNF45, associações, mapa de histórias e backlog. Planilha separada de 02/09 e DOCX com link preservados em entregas/anteriores/Engenharia de Requisitos/." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="451" width="1320" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="4. Contexto e produto" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="540" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="projeto/documentacao/: context.md_projeto_v_amos.md, prd_projeto_v_amos.md, Briefing_Projeto_Viamos.md e DESIGN.md. O briefing é referência histórica, confrontada com os arquivos do ZIP atual." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="571" width="1320" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="5. Arquitetura e protótipos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="660" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t14" value="entregas/anteriores/30-09/: Viamos_Entrega_Arquitetura_UML.pdf e Viamos_Diagramas_Editaveis.drawio (23 vistas). projeto/prototipos/Arquivos Stitch/: 12 HTMLs, 12 PNGs e DESIGN.md. Protótipos não representam uma aplicação integrada." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="691" width="1320" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="t15" value="6. Reprodução e revisão" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="780" width="1300" height="22.1" as="geometry" />
        </mxCell>
        <mxCell id="t16" value="A pasta fontes/ contém o gerador comum. diagramas/ contém SVGs vetoriais por página; Viamos_Modelagem_Editavel.drawio permite edição no diagrams.net. Viamos_Modelagem_Sistemas.pdf reúne as quatro categorias solicitadas e suas justificativas." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
