        <mxCell id="t5" value="JUSTIFICATIVA E REGRAS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=13;fontColor=#087e8b;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="834" width="1300" height="16.900000000000002" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="Cliente e intérprete aparecem repetidos apenas para organizar as trocas: cada perfil continua sendo uma única entidade externa. QR é exibido ao cliente e lido pelo intérprete. LGPD abrange consentimento, consulta, exportação e exclusão. Suporte recebe chamados; Backoffice analisa certificações." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="859" width="1330" height="39.0" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="Fontes: RF01–RF45; RNF28; contexto; UML anterior DU1–DU9. Os atores humanos são externos ao software." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526578;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="938" width="1330" height="15.600000000000001" as="geometry" />
