        </mxCell>
        <mxCell id="t6" value="RF19 e US09 preveem cancelamento antes do início e eventual taxa. A política deve ser apresentada ao cliente; prazo, valor e fórmula não foram fornecidos. O sistema revalida estado e autorização de forma atômica para evitar corrida com o check-in. Cancelar não é o mesmo que recusar uma oferta individual." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=15;fontColor=#213547;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="859" width="1330" height="39.0" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="RF18–RF19, RF42, RF44; US09. A máquina E1 usa a mesma guarda: não iniciado e política autoriza." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526578;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
