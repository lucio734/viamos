# Copie este arquivo para `.env` e ajuste os valores. O `.env` NÃO é versionado (.gitignore).

# Ambiente: development | test | production
NODE_ENV=development
PORT=3333

# Banco de dados PostgreSQL (docker compose local OU Neon)
DATABASE_URL=postgresql://viamos:viamos@localhost:5432/viamos
# Banco usado pelos testes automatizados (npm test). Nunca aponte para o banco de desenvolvimento/produção.
DATABASE_URL_TEST=postgresql://viamos:viamos@localhost:5432/viamos_test

# Segredo para assinar os tokens JWT (gere um valor longo e aleatório em produção: `openssl rand -hex 32`)
JWT_SECRET=troque-este-segredo-em-producao
# Duração da sessão (formato do pacote jsonwebtoken: 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# Origem(ns) do frontend autorizadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# URL pública da API (usada em links de recuperação de senha e no comprovante PDF)
API_PUBLIC_URL=http://localhost:3333
# URL pública do frontend (usada na página de verificação do comprovante e nos links por e-mail)
FRONTEND_URL=http://localhost:5173

# Integrações simuladas no MVP (gateway de pagamento e e-mail). Em produção: trocar por provedores reais.
GATEWAY_PAGAMENTO=simulado
EMAIL_PROVIDER=console
